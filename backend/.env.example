# ====================================================
# SMART TRAFFIC PREDICTION - BACKEND ENVIRONMENT
# Copy to .env and fill in your keys (never commit .env)
# ====================================================

# External API Keys
OPENWEATHER_API_KEY=
TOMTOM_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_HOST=irctc1.p.rapidapi.com

# Frontend Origins (CORS) - Comma-separated deployed URLs (e.g. Vercel)
FRONTEND_ORIGINS=https://smart-traffic.vercel.app

# Server Configuration
PORT=5000
FLASK_DEBUG=0

# Database Configuration (Optional - Defaults to backend/traffic.db)
# On Render persistent disk, you can set: /var/data/traffic.db
# DATABASE_PATH=/var/data/traffic.db
ADMIN_USERNAME=yogi
